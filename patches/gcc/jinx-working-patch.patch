diff --git gcc-workdir/libgcc/config/i386/t-badgeros64 gcc-workdir/libgcc/config/i386/t-badgeros64
new file mode 100644
index 0000000..bdc2a38
--- /dev/null
+++ gcc-workdir/libgcc/config/i386/t-badgeros64
@@ -0,0 +1,3 @@
+# x86_64 SysV ABI mandates SSE/SSE2 for _Complex double etc. return values;
+# make sure libgcc2.c's __muldc3/__divdc3 always see it enabled.
+HOST_LIBGCC2_CFLAGS += -msse -msse2
